# ==============================================================================
# SNACKFLOW ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# PROFILE A: Local Development / Offline Evaluator (Docker Compose)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://snackflow:snackflow123@localhost:5432/snackflow_db?schema=public"
DIRECT_URL="postgresql://snackflow:snackflow123@localhost:5432/snackflow_db?schema=public"
READONLY_DATABASE_URL="postgresql://snackflow:snackflow123@localhost:5432/snackflow_db?schema=public"
# READ_REPLICA_URL="" # Optional read replica endpoint

# ------------------------------------------------------------------------------
# PROFILE B: Neon Serverless Postgres (Cloud Hosted Demo & CI Branching)
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://app_runtime:PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/snackflow?sslmode=require"
# DIRECT_URL="postgresql://snackflow_owner:PASSWORD@ep-sample.ap-southeast-1.aws.neon.tech/snackflow?sslmode=require"
# READONLY_DATABASE_URL="postgresql://app_readonly:PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/snackflow?sslmode=require"
# READ_REPLICA_URL="postgresql://app_readonly:PASSWORD@ep-sample-read-pooler.ap-southeast-1.aws.neon.tech/snackflow?sslmode=require"

# Database Connection Tuning
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_S=15
APP_TZ="Asia/Kolkata"

# Redis (BullMQ Job Queue & Cache)
REDIS_URL="redis://localhost:6379"

# Security & Cryptographic Secrets (Argon2id, JWT, HMAC-SHA256)
JWT_ACCESS_SECRET="snackflow-development-super-secret-access-token-2026-secure"
JWT_REFRESH_SECRET="snackflow-development-super-secret-refresh-token-2026-secure"
HMAC_SHARE_SECRET="snackflow-development-hmac-share-invoice-key-2026-secure"

# SMTP & Mail Delivery (Local Mailpit: http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="orders@snackflow.local"

# Service Ports, Origins & Reverse-Proxy Cookie Settings
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
WEB_BASE_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"
# TRUST_PROXY="1"
# COOKIE_SAMESITE="none" # Set "none" + COOKIE_SECURE="true" for HTTPS cross-origin deployments (e.g., Netlify + external API)
# COOKIE_SECURE="true"
NODE_ENV="development"

# Neon Project & API Credentials (Required only for CI branching & pnpm demo:reset)
# NEON_API_KEY="your-neon-api-key"
# NEON_PROJECT_ID="your-neon-project-id"
